import streamlit as st
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)


st.set_page_config(
    page_title="Fraud Detection Analytics",
    page_icon="🔍",
    layout="wide"
)


st.title("🔍 Fraud Detection Analytics")
st.write(
    "Analyze financial transactions and identify potentially fraudulent transactions "
    "using Machine Learning."
)

st.divider()

st.sidebar.header("⚙️ Settings")

uploaded_file = st.sidebar.file_uploader(
    "Upload Transaction Dataset",
    type=["csv", "xlsx"]
)

use_sample = st.sidebar.checkbox(
    "Use Sample Dataset",
    value=True
)

@st.cache_data
def load_data(uploaded_file):
    if uploaded_file.name.endswith(".csv"):
        return pd.read_csv(uploaded_file)

    if uploaded_file.name.endswith(".xlsx"):
        return pd.read_excel(uploaded_file)

    return None


@st.cache_data
def create_sample_data():

    np.random.seed(42)

    n = 2000

    df = pd.DataFrame({
        "transaction_amount": np.random.uniform(10, 5000, n),
        "transaction_hour": np.random.randint(0, 24, n),
        "customer_age": np.random.randint(18, 70, n),
        "previous_transactions": np.random.randint(1, 100, n),
        "failed_transactions": np.random.randint(0, 10, n),
        "account_age_days": np.random.randint(30, 3000, n),
        "distance_from_home": np.random.uniform(0, 1000, n),
        "is_international": np.random.randint(0, 2, n)
    })

    fraud_probability = (
        (df["transaction_amount"] > 3500).astype(int) * 0.30
        + (df["failed_transactions"] > 5).astype(int) * 0.20
        + (df["distance_from_home"] > 700).astype(int) * 0.20
        + (df["is_international"] == 1).astype(int) * 0.15
        + (df["transaction_hour"].isin([0, 1, 2, 3, 4])).astype(int) * 0.15
    )

    random_values = np.random.random(n)

    df["is_fraud"] = (
        random_values < fraud_probability
    ).astype(int)

    return df


df = None

if uploaded_file is not None:

    try:
        df = load_data(uploaded_file)

        if df is None:
            st.error("Unable to read the uploaded file.")

    except Exception as error:
        st.error(f"Error reading file: {error}")

elif use_sample:

    df = create_sample_data()


if df is None:

    st.info(
        "Please upload a CSV/Excel dataset or select 'Use Sample Dataset'."
    )

    st.stop()


df.columns = (
    df.columns
    .str.strip()
    .str.lower()
    .str.replace(" ", "_")
)


st.header("📊 Dataset Overview")

col1, col2, col3, col4 = st.columns(4)

with col1:
    st.metric(
        "Total Transactions",
        len(df)
    )

with col2:
    st.metric(
        "Total Features",
        len(df.columns)
    )

with col3:
    st.metric(
        "Missing Values",
        int(df.isnull().sum().sum())
    )

with col4:
    st.metric(
        "Duplicate Rows",
        int(df.duplicated().sum())
    )


st.subheader("📋 Transaction Data")

st.dataframe(
    df.head(10),
    use_container_width=True
)

st.header("🧹 Data Cleaning")

df_clean = df.copy()

# Remove duplicate rows
df_clean = df_clean.drop_duplicates()

# Fill numeric missing values with median
numeric_columns = df_clean.select_dtypes(
    include=np.number
).columns

for column in numeric_columns:

    if df_clean[column].isnull().sum() > 0:

        df_clean[column] = df_clean[column].fillna(
            df_clean[column].median()
        )

# Fill categorical missing values
categorical_columns = df_clean.select_dtypes(
    exclude=np.number
).columns

for column in categorical_columns:

    if df_clean[column].isnull().sum() > 0:

        mode_value = df_clean[column].mode()

        if len(mode_value) > 0:
            df_clean[column] = df_clean[column].fillna(
                mode_value[0]
            )

st.success(
    f"Data cleaning completed. Final rows: {len(df_clean)}"
)

possible_target_columns = [
    "is_fraud",
    "fraud",
    "fraud_flag",
    "is_fraudulent",
    "label",
    "target"
]

target_column = None

for column in possible_target_columns:

    if column in df_clean.columns:
        target_column = column
        break


if target_column is not None:

    st.header("🚨 Fraud Distribution")

    fraud_counts = df_clean[target_column].value_counts()

    col1, col2 = st.columns(2)

    with col1:

        st.subheader("Fraud Count")

        st.dataframe(
            fraud_counts.rename("Count"),
            use_container_width=True
        )

    with col2:

        fig, ax = plt.subplots()

        fraud_counts.plot(
            kind="bar",
            ax=ax
        )

        ax.set_title("Fraud vs Genuine Transactions")
        ax.set_xlabel("Transaction Class")
        ax.set_ylabel("Number of Transactions")

        plt.xticks(rotation=0)

        st.pyplot(fig)

        plt.close(fig)


else:

    st.warning(
        "Fraud target column not found. "
        "Use one of these names: is_fraud, fraud, fraud_flag, "
        "is_fraudulent, label or target."
    )

    st.stop()


st.header("🤖 Machine Learning Model")

model_df = df_clean.copy()

# Convert target column to numeric
target_values = model_df[target_column]

if not pd.api.types.is_numeric_dtype(target_values):

    unique_values = target_values.astype(str).str.lower().unique()

    mapping = {}

    for value in unique_values:

        if value in ["fraud", "yes", "true", "1"]:
            mapping[value] = 1

        elif value in ["genuine", "normal", "no", "false", "0"]:
            mapping[value] = 0

    model_df[target_column] = (
        target_values.astype(str)
        .str.lower()
        .map(mapping)
    )


model_df = model_df.dropna(
    subset=[target_column]
)

model_df[target_column] = model_df[target_column].astype(int)


X = model_df.drop(
    columns=[target_column]
)

y = model_df[target_column]


# Keep numeric columns
X = X.select_dtypes(
    include=np.number
)

X = X.loc[
    :,
    X.nunique() > 1
]

if X.shape[1] == 0:

    st.error(
        "No suitable numeric features were found in the dataset."
    )

    st.stop()


X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)


model = RandomForestClassifier(
    n_estimators=150,
    random_state=42,
    class_weight="balanced",
    n_jobs=-1
)

model.fit(
    X_train,
    y_train
)


y_pred = model.predict(X_test)



accuracy = accuracy_score(
    y_test,
    y_pred
)

precision = precision_score(
    y_test,
    y_pred,
    zero_division=0
)

recall = recall_score(
    y_test,
    y_pred,
    zero_division=0
)

f1 = f1_score(
    y_test,
    y_pred,
    zero_division=0
)


st.subheader("📈 Model Performance")

col1, col2, col3, col4 = st.columns(4)

with col1:
    st.metric(
        "Accuracy",
        f"{accuracy:.2%}"
    )

with col2:
    st.metric(
        "Precision",
        f"{precision:.2%}"
    )

with col3:
    st.metric(
        "Recall",
        f"{recall:.2%}"
    )

with col4:
    st.metric(
        "F1 Score",
        f"{f1:.2%}"
    )

st.subheader("🔲 Confusion Matrix")

cm = confusion_matrix(
    y_test,
    y_pred
)

fig, ax = plt.subplots()

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    ax=ax
)

ax.set_xlabel("Predicted")
ax.set_ylabel("Actual")
ax.set_title("Fraud Detection Confusion Matrix")

st.pyplot(fig)

plt.close(fig)


st.subheader("📄 Classification Report")

report = classification_report(
    y_test,
    y_pred,
    output_dict=True,
    zero_division=0
)

report_df = pd.DataFrame(report).transpose()

st.dataframe(
    report_df,
    use_container_width=True
)


st.header("⭐ Feature Importance")

importance_df = pd.DataFrame({
    "Feature": X.columns,
    "Importance": model.feature_importances_
})

importance_df = importance_df.sort_values(
    by="Importance",
    ascending=False
)

st.dataframe(
    importance_df,
    use_container_width=True
)

fig, ax = plt.subplots()

ax.barh(
    importance_df["Feature"],
    importance_df["Importance"]
)

ax.set_xlabel("Importance")
ax.set_ylabel("Feature")
ax.set_title("Feature Importance")

ax.invert_yaxis()

st.pyplot(fig)

plt.close(fig)


st.header("🔮 Test a New Transaction")

st.write(
    "Enter transaction information below to predict whether "
    "the transaction is potentially fraudulent."
)

input_values = {}

input_columns = st.columns(2)

for index, feature in enumerate(X.columns):

    with input_columns[index % 2]:

        min_value = float(X[feature].min())
        max_value = float(X[feature].max())
        default_value = float(X[feature].median())

        input_values[feature] = st.number_input(
            feature.replace("_", " ").title(),
            min_value=min_value,
            max_value=max_value,
            value=default_value
        )


if st.button(
    "🔍 Detect Fraud",
    type="primary"
):

    input_df = pd.DataFrame(
        [input_values]
    )

    prediction = model.predict(
        input_df
    )[0]

    probability = model.predict_proba(
        input_df
    )[0]

    fraud_probability = probability[
        list(model.classes_).index(1)
    ] if 1 in model.classes_ else 0

    if prediction == 1:

        st.error(
            f"🚨 Potential Fraud Detected\n\n"
            f"Fraud Probability: {fraud_probability:.2%}"
        )

    else:

        st.success(
            f"✅ Transaction Classified as Genuine\n\n"
            f"Fraud Probability: {fraud_probability:.2%}"
        )


st.divider()

st.caption(
    "Fraud Detection Analytics | Python | Pandas | Scikit-learn | Streamlit"
)
