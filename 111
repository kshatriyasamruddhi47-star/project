import streamlit as st
import pandas as pd
import numpy as np
import plotly.express as px


st.set_page_config(
    page_title="AI-Powered Business Intelligence",
    page_icon="📊",
    layout="wide"
)


st.title("📊 AI-Powered Business Intelligence Dashboard")

st.write(
    """
    Upload your business dataset and get automatic business analysis,
    KPIs, interactive charts, and AI-generated business insights.
    """
)


st.sidebar.header("⚙️ Dashboard Settings")

uploaded_file = st.sidebar.file_uploader(
    "Upload CSV or Excel file",
    type=["csv", "xlsx"]
)


def load_data(file):
    try:
        if file.name.lower().endswith(".csv"):
            return pd.read_csv(file)

        elif file.name.lower().endswith(".xlsx"):
            return pd.read_excel(file)

        else:
            return None

    except Exception as error:
        st.error(f"Error while reading file: {error}")
        return None


def create_sample_data():
    np.random.seed(42)

    n = 200

    dates = pd.date_range(
        start="2025-01-01",
        end="2025-12-31",
        periods=n
    )

    regions = [
        "North",
        "South",
        "East",
        "West"
    ]

    categories = [
        "Electronics",
        "Furniture",
        "Clothing",
        "Food"
    ]

    products = [
        "Laptop",
        "Mobile",
        "Chair",
        "Table",
        "Shirt",
        "Shoes",
        "Rice",
        "Snacks"
    ]

    data = pd.DataFrame({
        "Date": dates,
        "Region": np.random.choice(regions, n),
        "Category": np.random.choice(categories, n),
        "Product": np.random.choice(products, n),
        "Sales": np.random.randint(5000, 50000, n),
        "Cost": np.random.randint(2000, 30000, n),
        "Quantity": np.random.randint(1, 50, n)
    })

    data["Profit"] = data["Sales"] - data["Cost"]

    return data


if uploaded_file is not None:

    df = load_data(uploaded_file)

    if df is None:
        st.stop()

    st.success("Dataset uploaded successfully!")

else:

    df = create_sample_data()

    st.info(
        "No file uploaded. The dashboard is currently using sample business data."
    )


df = df.copy()

# Remove completely empty rows
df = df.dropna(how="all")

# Remove duplicate rows
df = df.drop_duplicates()

# Convert column names to clean format
df.columns = (
    df.columns
    .str.strip()
    .str.replace(" ", "_")
)


for column in df.columns:

    if df[column].dtype == "object":

        try:

            converted = pd.to_numeric(
                df[column],
                errors="coerce"
            )

            valid_values = converted.notna().sum()

            if valid_values > len(df) * 0.7:
                df[column] = converted

        except Exception:
            pass


numeric_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_columns = df.select_dtypes(
    include=["object", "category"]
).columns.tolist()


if "Sales" in df.columns and "Cost" in df.columns:

    df["Profit"] = (
        pd.to_numeric(df["Sales"], errors="coerce").fillna(0)
        -
        pd.to_numeric(df["Cost"], errors="coerce").fillna(0)
    )

    if "Profit" not in numeric_columns:
        numeric_columns.append("Profit")


st.header("📌 Business KPIs")

col1, col2, col3, col4 = st.columns(4)


# Total Sales
if "Sales" in df.columns:

    total_sales = pd.to_numeric(
        df["Sales"],
        errors="coerce"
    ).fillna(0).sum()

else:

    total_sales = 0


# Total Cost
if "Cost" in df.columns:

    total_cost = pd.to_numeric(
        df["Cost"],
        errors="coerce"
    ).fillna(0).sum()

else:

    total_cost = 0


# Total Profit
if "Profit" in df.columns:

    total_profit = pd.to_numeric(
        df["Profit"],
        errors="coerce"
    ).fillna(0).sum()

else:

    total_profit = total_sales - total_cost


# Profit Margin
if total_sales != 0:

    profit_margin = (
        total_profit / total_sales
    ) * 100

else:

    profit_margin = 0


with col1:

    st.metric(
        "💰 Total Sales",
        f"₹{total_sales:,.0f}"
    )


with col2:

    st.metric(
        "💵 Total Profit",
        f"₹{total_profit:,.0f}"
    )


with col3:

    st.metric(
        "📈 Profit Margin",
        f"{profit_margin:.2f}%"
    )


with col4:

    st.metric(
        "📦 Total Records",
        f"{len(df):,}"
    )


st.header("📋 Dataset Information")

info_col1, info_col2, info_col3, info_col4 = st.columns(4)

with info_col1:

    st.metric(
        "Rows",
        len(df)
    )

with info_col2:

    st.metric(
        "Columns",
        len(df.columns)
    )

with info_col3:

    st.metric(
        "Missing Values",
        int(df.isnull().sum().sum())
    )

with info_col4:

    st.metric(
        "Duplicate Rows",
        int(df.duplicated().sum())
    )



with st.expander("👀 View Dataset"):

    st.dataframe(
        df,
        use_container_width=True
    )



st.header("📈 Sales & Profit Analysis")

if "Sales" in df.columns and "Profit" in df.columns:

    sales_col, profit_col = st.columns(2)

    with sales_col:

        sales_chart = px.histogram(
            df,
            x="Sales",
            nbins=20,
            title="Sales Distribution"
        )

        st.plotly_chart(
            sales_chart,
            use_container_width=True
        )

    with profit_col:

        profit_chart = px.histogram(
            df,
            x="Profit",
            nbins=20,
            title="Profit Distribution"
        )

        st.plotly_chart(
            profit_chart,
            use_container_width=True
        )

else:

    st.warning(
        "Sales and Profit columns are required for this analysis."
    )



if "Region" in df.columns:

    st.header("🌍 Regional Performance")

    region_data = (
        df.groupby("Region", as_index=False)
        .agg(
            Sales=("Sales", "sum"),
            Profit=("Profit", "sum")
        )
    )

    region_col1, region_col2 = st.columns(2)

    with region_col1:

        region_sales_chart = px.bar(
            region_data,
            x="Region",
            y="Sales",
            title="Sales by Region",
            text_auto=True
        )

        st.plotly_chart(
            region_sales_chart,
            use_container_width=True
        )

    with region_col2:

        region_profit_chart = px.bar(
            region_data,
            x="Region",
            y="Profit",
            title="Profit by Region",
            text_auto=True
        )

        st.plotly_chart(
            region_profit_chart,
            use_container_width=True
        )



if "Category" in df.columns:

    st.header("🛍️ Category Performance")

    category_data = (
        df.groupby("Category", as_index=False)
        .agg(
            Sales=("Sales", "sum"),
            Profit=("Profit", "sum")
        )
    )

    category_col1, category_col2 = st.columns(2)

    with category_col1:

        category_sales_chart = px.pie(
            category_data,
            names="Category",
            values="Sales",
            title="Sales Distribution by Category"
        )

        st.plotly_chart(
            category_sales_chart,
            use_container_width=True
        )

    with category_col2:

        category_profit_chart = px.bar(
            category_data,
            x="Category",
            y="Profit",
            title="Profit by Category",
            text_auto=True
        )

        st.plotly_chart(
            category_profit_chart,
            use_container_width=True
        )



if "Product" in df.columns:

    st.header("🏆 Product Performance")

    product_data = (
        df.groupby("Product", as_index=False)
        .agg(
            Sales=("Sales", "sum"),
            Profit=("Profit", "sum")
        )
        .sort_values(
            "Sales",
            ascending=False
        )
    )

    product_chart = px.bar(
        product_data,
        x="Product",
        y="Sales",
        title="Sales by Product",
        text_auto=True
    )

    st.plotly_chart(
        product_chart,
        use_container_width=True
    )

    st.subheader("Product Performance Table")

    st.dataframe(
        product_data,
        use_container_width=True
    )


st.header("🤖 AI-Powered Business Insights")


insights = []


# Sales insight

if total_sales > 0:

    insights.append(
        f"Total business sales are ₹{total_sales:,.0f}."
    )


# Profit insight

if total_profit > 0:

    insights.append(
        f"The business generated a total profit of ₹{total_profit:,.0f}."
    )

elif total_profit < 0:

    insights.append(
        f"The business currently has a total loss of ₹{abs(total_profit):,.0f}."
    )


# Profit margin insight

if profit_margin >= 30:

    insights.append(
        f"Profit margin is {profit_margin:.2f}%, indicating strong profitability."
    )

elif profit_margin >= 15:

    insights.append(
        f"Profit margin is {profit_margin:.2f}%. There is room for further improvement."
    )

else:

    insights.append(
        f"Profit margin is only {profit_margin:.2f}%. Cost control should be examined."
    )


# Regional insights

if "Region" in df.columns:

    region_analysis = (
        df.groupby("Region")["Sales"]
        .sum()
        .sort_values(ascending=False)
    )

    if len(region_analysis) > 0:

        best_region = region_analysis.index[0]

        lowest_region = region_analysis.index[-1]

        insights.append(
            f"{best_region} is the highest-sales region."
        )

        if len(region_analysis) > 1:

            insights.append(
                f"{lowest_region} has the lowest sales among the analyzed regions."
            )


# Category insights

if "Category" in df.columns:

    category_analysis = (
        df.groupby("Category")["Sales"]
        .sum()
        .sort_values(ascending=False)
    )

    if len(category_analysis) > 0:

        best_category = category_analysis.index[0]

        insights.append(
            f"{best_category} is the highest-performing category based on sales."
        )


# Product insights

if "Product" in df.columns:

    product_analysis = (
        df.groupby("Product")["Sales"]
        .sum()
        .sort_values(ascending=False)
    )

    if len(product_analysis) > 0:

        best_product = product_analysis.index[0]

        insights.append(
            f"{best_product} generated the highest sales among the available products."
        )


# Display insights

if insights:

    for i, insight in enumerate(insights, start=1):

        st.info(
            f"💡 Insight {i}: {insight}"
        )

else:

    st.warning(
        "Not enough information available to generate business insights."
    )



if len(numeric_columns) >= 2:

    st.header("🔗 Business Data Relationships")

    correlation_data = df[numeric_columns].corr()

    correlation_chart = px.imshow(
        correlation_data,
        text_auto=True,
        title="Correlation Matrix",
        aspect="auto"
    )

    st.plotly_chart(
        correlation_chart,
        use_container_width=True
    )


st.header("🧹 Data Quality Analysis")

missing_data = (
    df.isnull()
    .sum()
    .reset_index()
)

missing_data.columns = [
    "Column",
    "Missing_Values"
]

missing_data = missing_data[
    missing_data["Missing_Values"] > 0
]


if len(missing_data) > 0:

    missing_chart = px.bar(
        missing_data,
        x="Column",
        y="Missing_Values",
        title="Missing Values by Column",
        text_auto=True
    )

    st.plotly_chart(
        missing_chart,
        use_container_width=True
    )

else:

    st.success(
        "✅ No missing values found in the dataset."
    )


st.header("⬇️ Download Processed Data")

csv_data = df.to_csv(
    index=False
).encode("utf-8")


st.download_button(
    label="📥 Download CSV",
    data=csv_data,
    file_name="processed_business_data.csv",
    mime="text/csv"
)



st.markdown("---")

st.caption(
    "AI-Powered Business Intelligence | Python + Pandas + Streamlit + Plotly"
)
